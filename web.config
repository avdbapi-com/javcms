<?xml version="1.0" encoding="UTF-8"?>
<!-- Copy to the application root as web.config AFTER IIS PHP FastCGI/URL Rewrite installation.
     This intentionally preserves the site's existing PHP FastCGI handler registration. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <directoryBrowse enabled="false" />
      <defaultDocument enabled="true">
        <files><clear /><add value="index.php" /></files>
      </defaultDocument>
      <rewrite>
        <rules>
          <rule name="JAVCMS private roots" stopProcessing="true">
            <match url="^(application|runtime|vendor|thinkphp|extend|deployment|backup|backups)(/|$)" />
            <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
          </rule>
          <rule name="JAVCMS theme template sources" stopProcessing="true">
            <match url="^template/[^/]+/html(/|$)" />
            <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
          </rule>
          <rule name="JAVCMS dotfiles" stopProcessing="true">
            <match url="(^|/)\.(?!well-known(/|$))|^\.well-known/(?!acme-challenge/)" />
            <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
          </rule>
          <rule name="JAVCMS config and archives" stopProcessing="true">
            <match url="\.(ini|log|sql|sqlite|bak|conf|ya?ml)(/|$)|^(composer\.(json|lock)|package(-lock)?\.json|(README|INSTALL|UPGRADE|CHANGELOG)(\.(md|txt))?|docs/[^/]*\.md|LICENSE(\.[^/]+)?|NOTICE(\.[^/]+)?|[^/]+\.(zip|gz|7z|tar))(/|$)" />
            <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
          </rule>
          <rule name="JAVCMS no executable uploads" stopProcessing="true">
            <match url="^upload/.*\.(php[0-9]?|phtml|phar|cgi|pl|py|asp|aspx|jsp|sh)([./]|$)" />
            <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
          </rule>
          <rule name="JAVCMS entry PATH_INFO" stopProcessing="true">
            <match url="^(index|api|javcms|install)\.php/(.*)$" ignoreCase="false" />
            <action type="Rewrite" url="{R:1}.php?s=/{UrlEncode:{R:2}}" appendQueryString="true" />
          </rule>
          <rule name="JAVCMS four PHP entrances" stopProcessing="true">
            <match url="^(index|api|javcms|install)\.php$" ignoreCase="false" />
            <action type="None" />
          </rule>
          <rule name="JAVCMS no other PHP" stopProcessing="true">
            <match url="\.(php[0-9]?|phtml|phar)([./]|$)" />
            <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
          </rule>
          <!-- robots.txt is generated per site (Sitemap line for the configured domain); a root robots.txt only adds custom rules. -->
          <rule name="JAVCMS robots.txt" stopProcessing="true">
            <match url="^robots\.txt$" />
            <action type="Rewrite" url="index.php?s=/robots.txt" appendQueryString="true" />
          </rule>
          <rule name="JAVCMS public front controller" stopProcessing="true">
            <match url="^(.*)$" />
            <conditions logicalGrouping="MatchAll">
              <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
              <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            </conditions>
            <action type="Rewrite" url="index.php?s=/{UrlEncode:{R:1}}" appendQueryString="true" />
          </rule>
        </rules>
      </rewrite>
      <!-- Compression (SEO-ADMIN-BRIEF G): static files, and PHP pages / feeds / sitemaps when the IIS feature
           "Dynamic Content Compression" is installed. Responses PHP already compressed (gzip sitemaps) stay as they are. -->
      <urlCompression doStaticCompression="true" doDynamicCompression="true" />
      <!-- Static files (scripts, styles, JSON, images): browsers must not guess another content type. PHP pages send
           the same header themselves; a doubled "nosniff, nosniff" is still read as nosniff. -->
      <httpProtocol>
        <customHeaders>
          <remove name="X-Content-Type-Options" />
          <add name="X-Content-Type-Options" value="nosniff" />
        </customHeaders>
      </httpProtocol>
      <!-- Example ad media (static/jcx/x/): IIS refuses to serve an extension that has no MIME type. -->
      <staticContent>
        <remove fileExtension=".webp" />
        <mimeMap fileExtension=".webp" mimeType="image/webp" />
        <remove fileExtension=".webm" />
        <mimeMap fileExtension=".webm" mimeType="video/webm" />
        <remove fileExtension=".m3u8" />
        <mimeMap fileExtension=".m3u8" mimeType="application/vnd.apple.mpegurl" />
        <remove fileExtension=".m4s" />
        <mimeMap fileExtension=".m4s" mimeType="video/iso.segment" />
      </staticContent>
    </system.webServer>
  </location>
  <!-- Static files of the site and of the themes: browsers and CDNs keep them 30 days (1.2.0, XVID-SCALE-BRIEF L2).
       static/jcx/ (ad configuration and scripts) changes with the ad settings and keeps the server default. -->
  <location path="static" inheritInChildApplications="false">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" cacheControlCustom="public" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="static/jcx" inheritInChildApplications="false">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="NoControl" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="template" inheritInChildApplications="false">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" cacheControlCustom="public" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
